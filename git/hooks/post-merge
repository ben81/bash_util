set -euo pipefail

HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" 


# Récupérer les commits avant/après le merge
PRE_MERGE_COMMIT=$(git rev-parse ORIG_HEAD)
POST_MERGE_COMMIT=$(git rev-parse HEAD)

# Afficher les informations
echo "----------------------------------------"
echo "Post-merge hook triggered:"
echo "Commit avant le merge: $PRE_MERGE_COMMIT"
echo "Commit après le merge: $POST_MERGE_COMMIT"
echo "----------------------------------------"


source "$HOOKS_DIR/lib/checks.sh"

run_checks "${PRE_MERGE_COMMIT}" "${POST_MERGE_COMMIT}"
